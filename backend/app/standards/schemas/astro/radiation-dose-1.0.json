{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tylanauts.example/schemas/astro/radiation-dose-1.0.json",
  "title": "Radiation Dose Equivalent",
  "description": "Radiation dose equivalent from a personal dosimeter, for a point in time or a period. Not covered by Open mHealth; follows its conventions.",
  "type": "object",
  "properties": {
    "radiation_dose_equivalent": {
      "allOf": [
        { "$ref": "https://w3id.org/ieee/ieee-1752-schema/unit-value-1.0.json" },
        { "properties": { "unit": { "enum": ["mSv"] }, "value": { "minimum": 0 } } }
      ]
    },
    "effective_time_frame": { "$ref": "https://w3id.org/ieee/ieee-1752-schema/time-frame-1.0.json" }
  },
  "required": ["radiation_dose_equivalent", "effective_time_frame"]
}
