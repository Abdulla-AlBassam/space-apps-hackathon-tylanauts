{
  "openapi": "3.1.0",
  "info": {
    "title": "Siryius Health Data API",
    "description": "Collects health readings from many devices and inputs and stores them as IEEE 1752.1 / Open mHealth data points. Sending data needs the X-Api-Key header when the server has a key set; reading does not.",
    "version": "0.4.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Is the server up, and which storage it uses",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/metrics": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Metrics the backend understands",
        "operationId": "list_metrics",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MetricInfo"
                  },
                  "type": "array",
                  "title": "Response List Metrics"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/adapters": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Input formats that can be ingested",
        "operationId": "list_adapters",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdapterInfo"
                  },
                  "type": "array",
                  "title": "Response List Adapters"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ingest/{adapter_id}": {
      "post": {
        "tags": [
          "ingestion"
        ],
        "summary": "Ingest a payload through an adapter",
        "description": "Parses the payload, converts every reading to the standard format and stores it. Bad records are rejected individually with a reason; the rest are still stored. Sending the same readings twice is safe: repeats are counted as duplicates.",
        "operationId": "ingest",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "adapter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Adapter id, e.g. 'manual-entry'.",
              "title": "Adapter Id"
            },
            "description": "Adapter id, e.g. 'manual-entry'."
          },
          {
            "name": "subject_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,100}$",
              "description": "Who the data belongs to, e.g. 'astro-01'.",
              "title": "Subject Id"
            },
            "description": "Who the data belongs to, e.g. 'astro-01'."
          },
          {
            "name": "device_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]{1,100}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Which physical device, if known.",
              "title": "Device Id"
            },
            "description": "Which physical device, if known."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionReport"
                }
              }
            }
          },
          "400": {
            "description": "Nothing in the payload could be read (e.g. not valid JSON)"
          },
          "401": {
            "description": "Missing or wrong X-Api-Key header"
          },
          "404": {
            "description": "Unknown adapter"
          },
          "413": {
            "description": "Payload too large"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "description": "The raw payload in the adapter's format (see GET /api/v1/adapters for examples).",
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            },
            "text/csv": {
              "schema": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "/api/v1/ingestions": {
      "get": {
        "tags": [
          "ingestion"
        ],
        "summary": "Recent ingestion reports, newest first",
        "operationId": "list_ingestions",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "subject_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only uploads for this subject.",
              "title": "Subject Id"
            },
            "description": "Only uploads for this subject."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IngestionReport"
                  },
                  "title": "Response List Ingestions"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ingestions/{ingestion_id}": {
      "get": {
        "tags": [
          "ingestion"
        ],
        "summary": "Report for a past ingestion",
        "operationId": "get_ingestion",
        "parameters": [
          {
            "name": "ingestion_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ingestion Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/subjects": {
      "get": {
        "tags": [
          "data points"
        ],
        "summary": "Subjects that have data",
        "operationId": "list_subjects",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "title": "Response List Subjects"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/subjects/{subject_id}/data-points": {
      "get": {
        "tags": [
          "data points"
        ],
        "summary": "Stored data points for one subject",
        "operationId": "query_data_points",
        "parameters": [
          {
            "name": "subject_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Subject Id"
            }
          },
          {
            "name": "metric",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only this metric, e.g. 'heart-rate'.",
              "title": "Metric"
            },
            "description": "Only this metric, e.g. 'heart-rate'."
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "From this time (inclusive). No timezone = UTC.",
              "title": "Start"
            },
            "description": "From this time (inclusive). No timezone = UTC."
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Up to this time (exclusive). No timezone = UTC.",
              "title": "End"
            },
            "description": "Up to this time (exclusive). No timezone = UTC."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5000,
              "minimum": 1,
              "default": 500,
              "title": "Limit"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string",
              "description": "'asc' = oldest first, 'desc' = newest first.",
              "default": "asc",
              "title": "Order"
            },
            "description": "'asc' = oldest first, 'desc' = newest first."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DataPointRecord"
                  },
                  "title": "Response Query Data Points"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stats": {
      "get": {
        "tags": [
          "data points"
        ],
        "summary": "What is stored: totals, and readings per subject and metric",
        "operationId": "get_stats",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sim": {
      "get": {
        "tags": [
          "live simulator"
        ],
        "summary": "Live simulator: levers, devices and storage",
        "operationId": "get_sim",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sim/settings": {
      "put": {
        "tags": [
          "live simulator"
        ],
        "summary": "Change the simulator's levers (whole settings object)",
        "operationId": "put_sim_settings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimSettings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sim/tick": {
      "post": {
        "tags": [
          "live simulator"
        ],
        "summary": "Send the device readings that are due, and clean up old simulated data",
        "description": "Called every few seconds by the live page while it's open. Sends at most one reading per device per 10 seconds however often it's called, through the real device adapters. Simulated readings older than the retention window are deleted.",
        "operationId": "sim_tick",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimView"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdapterInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "content_type": {
            "type": "string",
            "title": "Content Type"
          },
          "example": {
            "type": "string",
            "title": "Example"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "content_type",
          "example"
        ],
        "title": "AdapterInfo"
      },
      "ComponentInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "body_field": {
            "type": "string",
            "title": "Body Field"
          },
          "min": {
            "type": "number",
            "title": "Min"
          },
          "max": {
            "type": "number",
            "title": "Max"
          }
        },
        "type": "object",
        "required": [
          "name",
          "body_field",
          "min",
          "max"
        ],
        "title": "ComponentInfo"
      },
      "CoverageRow": {
        "properties": {
          "subject_id": {
            "type": "string",
            "title": "Subject Id"
          },
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "first": {
            "type": "string",
            "format": "date-time",
            "title": "First",
            "description": "Start of the earliest reading."
          },
          "last": {
            "type": "string",
            "format": "date-time",
            "title": "Last",
            "description": "End (or time) of the latest reading."
          }
        },
        "type": "object",
        "required": [
          "subject_id",
          "metric",
          "count",
          "first",
          "last"
        ],
        "title": "CoverageRow"
      },
      "CrewLevers": {
        "properties": {
          "stress": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Stress",
            "description": "Fatigue/stress: heart rate and blood pressure up, HRV down.",
            "default": 0
          },
          "low_oxygen": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Low Oxygen",
            "description": "Blood oxygen down, breathing and heart rate up.",
            "default": 0
          },
          "radiation": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Radiation",
            "description": "Radiation exposure: up to 40x the normal daily dose.",
            "default": 0
          }
        },
        "type": "object",
        "title": "CrewLevers"
      },
      "DataPointRecord": {
        "properties": {
          "uuid": {
            "type": "string",
            "title": "Uuid"
          },
          "subject_id": {
            "type": "string",
            "title": "Subject Id"
          },
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "device_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          },
          "adapter_id": {
            "type": "string",
            "title": "Adapter Id"
          },
          "ingestion_id": {
            "type": "string",
            "title": "Ingestion Id"
          },
          "effective_start": {
            "type": "string",
            "format": "date-time",
            "title": "Effective Start"
          },
          "effective_end": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective End"
          },
          "values": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Values",
            "description": "Flat values in canonical units, ready for analysis."
          },
          "data_point": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data Point",
            "description": "The IEEE 1752.1 / Open mHealth data point, exactly per spec."
          }
        },
        "type": "object",
        "required": [
          "uuid",
          "subject_id",
          "metric",
          "device_id",
          "adapter_id",
          "ingestion_id",
          "effective_start",
          "effective_end",
          "values",
          "data_point"
        ],
        "title": "DataPointRecord",
        "description": "A stored data point: the untouched standard data point plus our own bookkeeping around it.\n\nIEEE 1752.1 headers carry no user or device fields, so who/what/how lives here instead."
      },
      "DeviceLevers": {
        "properties": {
          "on": {
            "type": "boolean",
            "title": "On",
            "default": true
          },
          "faulty": {
            "type": "boolean",
            "title": "Faulty",
            "description": "Every other reading is an impossible value the backend rejects.",
            "default": false
          }
        },
        "type": "object",
        "title": "DeviceLevers"
      },
      "DeviceStatus": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "kind_label": {
            "type": "string",
            "title": "Kind Label"
          },
          "crew_id": {
            "type": "string",
            "title": "Crew Id"
          },
          "adapter_id": {
            "type": "string",
            "title": "Adapter Id"
          },
          "measures": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Measures"
          },
          "on": {
            "type": "boolean",
            "title": "On"
          },
          "faulty": {
            "type": "boolean",
            "title": "Faulty"
          },
          "last_sent": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Sent"
          },
          "last_values": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Last Values"
          },
          "sent_total": {
            "type": "integer",
            "title": "Sent Total",
            "default": 0
          },
          "accepted_total": {
            "type": "integer",
            "title": "Accepted Total",
            "default": 0
          },
          "rejected_total": {
            "type": "integer",
            "title": "Rejected Total",
            "default": 0
          },
          "last_rejections": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Last Rejections"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "kind_label",
          "crew_id",
          "adapter_id",
          "measures",
          "on",
          "faulty"
        ],
        "title": "DeviceStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestionReport": {
        "properties": {
          "ingestion_id": {
            "type": "string",
            "title": "Ingestion Id"
          },
          "adapter_id": {
            "type": "string",
            "title": "Adapter Id"
          },
          "subject_id": {
            "type": "string",
            "title": "Subject Id"
          },
          "device_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Received At"
          },
          "received": {
            "type": "integer",
            "title": "Received",
            "description": "Records found in the payload."
          },
          "accepted": {
            "type": "integer",
            "title": "Accepted"
          },
          "duplicates": {
            "type": "integer",
            "title": "Duplicates"
          },
          "rejected": {
            "items": {
              "$ref": "#/components/schemas/RecordError"
            },
            "type": "array",
            "title": "Rejected"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "data_point_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Data Point Ids"
          }
        },
        "type": "object",
        "required": [
          "ingestion_id",
          "adapter_id",
          "subject_id",
          "device_id",
          "received_at",
          "received",
          "accepted",
          "duplicates",
          "rejected",
          "warnings",
          "data_point_ids"
        ],
        "title": "IngestionReport"
      },
      "MetricInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "schema_id": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Schema Id"
          },
          "canonical_unit": {
            "type": "string",
            "title": "Canonical Unit"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponentInfo"
            },
            "type": "array",
            "title": "Components"
          },
          "requires_period": {
            "type": "boolean",
            "title": "Requires Period"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "schema_id",
          "canonical_unit",
          "components",
          "requires_period"
        ],
        "title": "MetricInfo"
      },
      "RecordError": {
        "properties": {
          "ref": {
            "type": "string",
            "title": "Ref"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "ref",
          "reason"
        ],
        "title": "RecordError"
      },
      "SimSettings": {
        "properties": {
          "running": {
            "type": "boolean",
            "title": "Running",
            "default": false
          },
          "scenario": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario",
            "description": "Name of the preset last applied, if any."
          },
          "crew": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CrewLevers"
            },
            "type": "object",
            "title": "Crew"
          },
          "devices": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DeviceLevers"
            },
            "type": "object",
            "title": "Devices"
          }
        },
        "type": "object",
        "title": "SimSettings"
      },
      "SimView": {
        "properties": {
          "settings": {
            "$ref": "#/components/schemas/SimSettings"
          },
          "devices": {
            "items": {
              "$ref": "#/components/schemas/DeviceStatus"
            },
            "type": "array",
            "title": "Devices"
          },
          "interval_seconds": {
            "type": "integer",
            "title": "Interval Seconds"
          },
          "retention_minutes": {
            "type": "integer",
            "title": "Retention Minutes"
          },
          "last_tick": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Tick"
          },
          "accepted_this_tick": {
            "type": "integer",
            "title": "Accepted This Tick"
          },
          "live_readings_kept": {
            "type": "integer",
            "title": "Live Readings Kept"
          },
          "pruned_total": {
            "type": "integer",
            "title": "Pruned Total"
          },
          "storage_bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Storage Bytes"
          }
        },
        "type": "object",
        "required": [
          "settings",
          "devices",
          "interval_seconds",
          "retention_minutes",
          "last_tick",
          "accepted_this_tick",
          "live_readings_kept",
          "pruned_total",
          "storage_bytes"
        ],
        "title": "SimView"
      },
      "Stats": {
        "properties": {
          "data_points": {
            "type": "integer",
            "title": "Data Points"
          },
          "ingestions": {
            "type": "integer",
            "title": "Ingestions"
          },
          "coverage": {
            "items": {
              "$ref": "#/components/schemas/CoverageRow"
            },
            "type": "array",
            "title": "Coverage",
            "description": "One row per subject and metric that has data."
          }
        },
        "type": "object",
        "required": [
          "data_points",
          "ingestions",
          "coverage"
        ],
        "title": "Stats"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "description": "Shared key for sending data (ask the backend owner).",
        "in": "header",
        "name": "X-Api-Key"
      }
    }
  }
}
